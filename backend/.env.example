NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Conexão com pooling, utilizada normalmente pela aplicação
DATABASE_URL="postgresql://USUARIO:SENHA@HOST-pooler.neon.tech/neondb?sslmode=require&channel_binding=require"

# Conexão direta, utilizada pelas migrations do Prisma
DIRECT_URL="postgresql://USUARIO:SENHA@HOST.neon.tech/neondb?sslmode=require&channel_binding=require"

JWT_SECRET=gere-uma-chave-aleatoria-com-pelo-menos-32-bytes
JWT_ACCESS_SECONDS=900
JWT_REFRESH_DAYS=30
DEFAULT_PROGRAM_ID=ppgcc-ufpi

DATA_SOURCE_DIR=/caminho/para/observatorioPPG/data/integrados
CORRECTIONS_EXPORT_FILE=./exports/approved-corrections.json

# Usadas somente por npm run db:seed-admin
ADMIN_EMAIL=coordenacao@example.edu.br
ADMIN_PASSWORD=troque-por-uma-senha-forte
ADMIN_NAME=Coordenação
PROGRAM_ID=ppgcc-ufpi
PROGRAM_NAME=Programa de Pós-Graduação em Ciência da Computação da UFPI
PROGRAM_ACRONYM=PPGCC/UFPI

# Usadas somente por npm run db:seed-faculty
FACULTY_EMAIL=docente@example.edu.br
FACULTY_PASSWORD=troque-por-uma-senha-forte
FACULTY_NAME=Nome do docente
FACULTY_EXTERNAL_ID=doc_identificador_publicado_pelo_pipeline
