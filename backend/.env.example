# Runtime da API
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Copie as URLs em Supabase > Project Settings > Database > Connect.
# A URL com pooler é usada pela aplicação.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
# A conexão direta é usada pelas migrations.
DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# Supabase > Project Settings > API
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Caminhos relativos ao diretório backend/
DATA_SOURCE_DIR=../frontend/src/data
STATIC_FALLBACK_DIR=../frontend/public/dados
